{
  "realm": "devtrack",
  "displayName": "DevTrack Realm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Standard DevTrack developer role"
      },
      {
        "name": "ADMIN",
        "description": "DevTrack system administrator role with metrics access"
      }
    ]
  },
  "defaultRoles": [
    "USER"
  ],
  "clients": [
    {
      "clientId": "devtrack-frontend",
      "name": "DevTrack Frontend Web App",
      "description": "Single-page application client using Authorization Code Flow + PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5173",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:5173"
      ],
      "webOrigins": [
        "+",
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:5173"
      },
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "devtrack-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "devtrack-backend",
      "name": "DevTrack Backend Resource Server",
      "description": "Resource server representing API endpoints",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    }
  ],
  "users": [
    {
      "username": "dev_user",
      "enabled": true,
      "email": "developer@devtrack.local",
      "firstName": "Alex",
      "lastName": "Dev",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "username": "dev_admin",
      "enabled": true,
      "email": "admin@devtrack.local",
      "firstName": "Sarah",
      "lastName": "Admin",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "USER"
      ]
    }
  ]
}
