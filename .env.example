# ==============================================================================
# DevTrack Environment Configuration Template
# NOTE: Never commit production credentials to version control.
# Copy this file to .env for local Docker Compose execution.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=devtrack_db
POSTGRES_USER=devtrack_user
POSTGRES_PASSWORD=devtrack_secret_change_me_in_prod
POSTGRES_PORT=5432

# Keycloak Administrator Configuration (used for initial realm provisioning)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret_change_me_in_prod
KEYCLOAK_PORT=8080

# Keycloak Realm and OIDC URLs
# Browser-facing Keycloak base URL (accessed from browser host)
KEYCLOAK_FRONTEND_URL=http://localhost:8080
# Docker-internal Keycloak base URL (accessed from backend container)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=devtrack

# Spring Boot Backend Configuration
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://postgres:5432/devtrack_db
DATABASE_USERNAME=devtrack_user
DATABASE_PASSWORD=devtrack_secret_change_me_in_prod

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8081/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=devtrack
VITE_KEYCLOAK_CLIENT_ID=devtrack-frontend
