# ==============================================================================
# DevTrack Environment Configuration Template
# NOTE: Placeholders only. Never commit real production secrets to version control.
# Copy this file to .env and configure strong, unique secrets for your environment.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=devtrack_db
POSTGRES_USER=devtrack_user
POSTGRES_PASSWORD=<CHANGE_ME_GENERATE_STRONG_POSTGRES_PASSWORD>
POSTGRES_PORT=5432

# Dedicated Keycloak Database (created automatically on startup)
KEYCLOAK_DB=keycloak_db

# Keycloak Bootstrap Administrator Configuration (Master Realm)
# Required for initial setup and creating realm administrators.
KEYCLOAK_ADMIN=<CHANGE_ME_KEYCLOAK_ADMIN_USERNAME>
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME_GENERATE_STRONG_KEYCLOAK_ADMIN_PASSWORD>
KEYCLOAK_PORT=8080

# Keycloak Realm and OIDC URLs
# Browser-facing Keycloak base URL (accessed from host browser)
KEYCLOAK_FRONTEND_URL=http://localhost:8080
# Docker-internal Keycloak base URL (accessed container-to-container)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=devtrack

# Spring Boot Backend Configuration
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://postgres:5432/devtrack_db
DATABASE_USERNAME=devtrack_user
DATABASE_PASSWORD=<CHANGE_ME_MATCH_POSTGRES_PASSWORD_ABOVE>
KEYCLOAK_AUDIENCE=devtrack-backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8081/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=devtrack
VITE_KEYCLOAK_CLIENT_ID=devtrack-frontend
